# Database Configuration
# PostgreSQL connection string for your freelance-os database
DATABASE_URL="postgresql://freelance_user:your_secure_password@localhost:5432/freelance_os"

# NextAuth Configuration (for client portal authentication)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3011"

# Admin Dashboard Authentication
# Generate a secret with: openssl rand -base64 32
ADMIN_SECRET="your-admin-secret-here"

# AI Configuration (for timeline autofill feature)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Optional: Email Configuration (for invoice notifications)
# Get JMAP credentials from your email provider (e.g., Fastmail App Password)
JMAP_TOKEN=your_jmap_api_token_here
JMAP_USERNAME=sender@example.com
JMAP_HOSTNAME=api.fastmail.com

# Optional: Company/Branding Configuration (used in emails and PDFs)
COMPANY_NAME="Your Company Name"

# Optional: Application URLs (production)
# CLIENT_PORTAL_URL="https://portal.yourdomain.com"
# ADMIN_DASHBOARD_URL="https://admin.yourdomain.com"
