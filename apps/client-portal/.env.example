# Database
DATABASE_URL="postgresql://freelance_user:your_secure_password@localhost:5432/freelance_os"

# NextAuth Configuration
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3011"

# Email Provider (Resend for Magic Links)
# Get your API key from https://resend.com
AUTH_RESEND_KEY="re_xxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"

# Optional: Production URL
# CLIENT_PORTAL_URL="https://portal.yourdomain.com"
