{
  "name": "freelance-os",
  "version": "0.1.0",
  "description": "A unified monorepo for managing freelance business operations including activity tracking, client portal, and admin dashboard",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:setup": "cd packages/database && pnpm run setup",
    "db:migrate": "cd packages/database && pnpm run migrate"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.6.0"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20"
  }
}
