{
  "name": "@freelance-os/database",
  "version": "0.1.0",
  "description": "Shared PostgreSQL database schema and client for freelance-os",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
