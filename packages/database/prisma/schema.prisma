// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Activity tracking from your existing utility
model ActivitySession {
  id              Int      @id @default(autoincrement())
  startTime       DateTime @map("start_time") @db.Timestamptz
  endTime         DateTime @map("end_time") @db.Timestamptz
  appClass        String   @map("app_class") @db.VarChar(255)
  windowTitle     String?  @map("window_title") @db.Text
  durationSeconds Int      @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  ignored         Boolean  @default(false)

  @@index([appClass], name: "idx_sessions_app_class")
  @@index([startTime], name: "idx_sessions_start_time")
  @@index([endTime], name: "idx_sessions_end_time")
  @@index([appClass, startTime], name: "idx_sessions_app_time")
  @@map("activity_sessions")
}

model ActivitySummary {
  id                   Int      @id @default(autoincrement())
  appClass             String   @map("app_class") @db.VarChar(255)
  activityDetails      String?  @map("activity_details") @db.Text
  totalDurationSeconds Int      @map("total_duration_seconds")
  sessionCount         Int      @map("session_count")
  firstSeen            DateTime @map("first_seen") @db.Timestamptz
  lastSeen             DateTime @map("last_seen") @db.Timestamptz
  submittedAt          DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  @@index([appClass], name: "idx_summaries_app_class")
  @@index([firstSeen], name: "idx_summaries_first_seen")
  @@index([lastSeen], name: "idx_summaries_last_seen")
  @@index([submittedAt], name: "idx_summaries_submitted_at")
  @@map("activity_summaries")
}

// Client management
model Client {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String
  company   String?
  color     String    @default("#06B6D4") @db.VarChar(7) // Hex color for client visualizations
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  
  projects  Project[]
  invoices  Invoice[]
  apiKeys   ApiKey[]

  @@map("clients")
}

// Project tracking
model Project {
  id                 Int       @id @default(autoincrement())
  name               String
  clientDescription  String?   @map("client_description") @db.Text // Client-viewable description
  privateNotes       String?   @map("private_notes") @db.Text // Private notes (admin-only, for AI matching, etc.)
  clientId           Int       @map("client_id")
  status             String    @default("active") // active, completed, on-hold
  color              String    @default("#22C55E") @db.VarChar(7) // Hex color for timeline display
  billable           Boolean   @default(true) // General billable setting for project (affects time entry UI, invoicing, etc.)
  hourlyRate         Decimal?  @map("hourly_rate") @db.Decimal(10, 2) // Default hourly rate for invoicing
  startDate          DateTime? @map("start_date") @db.Timestamptz
  endDate            DateTime? @map("end_date") @db.Timestamptz
  linkedRtProjectId  Int?      @unique @map("linked_rt_project_id") // Optional link to a RescueTime project
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  linkedRtProject   RescueTimeProject? @relation(fields: [linkedRtProjectId], references: [rtProjectId])
  timeEntries       TimeEntry[]
  invoices          Invoice[]
  weeklySummaries   WeeklySummary[]
  highlights        ProjectHighlight[]

  @@index([clientId])
  @@map("projects")
}

// Project highlights — short labels marking significant dates during a project
model ProjectHighlight {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  date      DateTime @db.Date // Just the date, no time component
  label     String   @db.VarChar(100) // Short label, 2-5 words (e.g. "Launch day", "Dropped WebGL approach")
  emoji     String?  @db.VarChar(10)  // Optional emoji icon (e.g. "🚀", "🎉", "🏁")
  source    String   @default("manual") @db.VarChar(20) // "manual" | "ai-suggested"
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, date, label]) // Prevent duplicate highlights on the same date with the same label
  @@index([projectId])
  @@index([date])
  @@map("project_highlights")
}

// Weekly summaries for projects
model WeeklySummary {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  weekStart   DateTime @map("week_start") @db.Timestamptz // Monday of the week at 00:00:00 UTC
  summary     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, weekStart])
  @@index([projectId])
  @@index([weekStart])
  @@map("project_weekly_summaries")
}

// Time tracking entries (linked to projects)
model TimeEntry {
  id              Int      @id @default(autoincrement())
  projectId       Int      @map("project_id")
  description     String?  @db.Text
  startTime       DateTime @map("start_time") @db.Timestamptz
  endTime         DateTime @map("end_time") @db.Timestamptz
  durationMinutes Int      @map("duration_minutes")
  billable        Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([startTime])
  @@index([endTime])
  @@map("time_entries")
}

// Invoice management
model Invoice {
  id          Int      @id @default(autoincrement())
  invoiceNumber String @unique @map("invoice_number")
  clientId    Int      @map("client_id")
  projectId   Int?     @map("project_id")
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD") @db.VarChar(3)
  status      String   @default("draft") // draft, sent, paid, overdue, cancelled
  issueDate   DateTime @map("issue_date") @db.Timestamptz
  dueDate     DateTime @map("due_date") @db.Timestamptz
  paidDate    DateTime? @map("paid_date") @db.Timestamptz
  periodStart DateTime? @map("period_start") @db.Timestamptz // Start of the billing period (actual date range used to calculate amount)
  periodEnd   DateTime? @map("period_end") @db.Timestamptz   // End of the billing period (actual date range used to calculate amount)
  notes       String?  @db.Text
  aiSummary   String?  @map("ai_summary") @db.Text // AI-generated executive summary for the invoice period
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

// NextAuth.js tables for client portal authentication
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          String    @default("user") // "admin" or "user"
  passwordHash  String?   @map("password_hash") // For credentials provider
  clientId      Int?      @map("client_id") // Link to Client table for portal access

  accounts Account[]
  sessions Session[]
  apiKeys  ApiKey[]

  @@map("users")
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String    // User-defined name like "Mobile App" or "Integration Script"
  key         String    @unique // The actual API key (hashed)
  userId      String    @map("user_id") // Who created it
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    Int?      @map("client_id") // For client portal users, scope to their client
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  permissions String[]  // Array of allowed scopes like ["read:projects", "write:time"]
  lastUsedAt  DateTime? @map("last_used_at") @db.Timestamptz
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  
  @@index([userId])
  @@index([clientId])
  @@index([key])
  @@map("api_keys")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Auth provider configuration (which providers are enabled + their settings)
model AuthProviderConfig {
  id        String   @id @default(cuid())
  provider  String   @unique // "credentials", "email", "github", etc.
  enabled   Boolean  @default(false)
  config    Json?    // Provider-specific configuration
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("auth_provider_configs")
}

// Enum for AI provider selection
enum AiProvider {
  openai
  gemini
}

// Enum for AI job types
enum AiJobType {
  autofill_time_entries
  merge_rescuetime_activity
  generate_weekly_summary
  // Future: generate_invoice_description, analyze_productivity, etc.
}

// Enum for AI job status
enum AiJobStatus {
  pending
  processing
  completed
  failed
  cancelled
}

// Background AI jobs for async processing
model AiJob {
  id          Int         @id @default(autoincrement())
  type        AiJobType
  status      AiJobStatus @default(pending)
  progress    Int         @default(0) // 0-100 percentage
  
  // Job context/parameters (JSON)
  parameters  Json?       // e.g., { "date": "2024-10-22", "projectIds": [1,2,3] }
  
  // Results (JSON)
  result      Json?       // e.g., { "entriesCreated": 5, "suggestions": [...] }
  
  // Error tracking
  error       String?     @db.Text
  
  // Metadata
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  startedAt   DateTime?   @map("started_at") @db.Timestamptz
  completedAt DateTime?   @map("completed_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  telemetryRuns AiTelemetryRun[]
  
  @@index([type, status])
  @@index([status])
  @@index([createdAt])
  @@map("ai_jobs")
}

model AiTelemetryRun {
  id                 Int                     @id @default(autoincrement())
  jobId               Int                     @map("job_id")
  functionId          String                  @map("function_id") @db.VarChar(255)
  operation           String                  @default("generateText") @db.VarChar(100)
  modelProvider       String?                 @map("model_provider") @db.VarChar(100)
  modelId             String?                 @map("model_id") @db.VarChar(255)
  status              String                  @default("started") @db.VarChar(50)
  metadata            Json?
  inputPreview        String?                 @map("input_preview") @db.Text
  outputPreview       String?                 @map("output_preview") @db.Text
  responseText        String?                 @map("response_text") @db.Text
  finishReason        String?                 @map("finish_reason") @db.VarChar(100)
  promptTokens        Int?                    @map("prompt_tokens")
  completionTokens    Int?                    @map("completion_tokens")
  totalTokens         Int?                    @map("total_tokens")
  totalDurationMs     Int?                    @map("total_duration_ms")
  error               String?                 @db.Text
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  job                 AiJob                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  steps               AiTelemetryStep[]
  toolCalls           AiTelemetryToolCall[]

  @@index([jobId, createdAt])
  @@index([functionId])
  @@index([status])
  @@map("ai_telemetry_runs")
}

model AiTelemetryStep {
  id                 Int             @id @default(autoincrement())
  telemetryRunId     Int             @map("telemetry_run_id")
  stepNumber         Int             @map("step_number")
  modelProvider      String?         @map("model_provider") @db.VarChar(100)
  modelId            String?         @map("model_id") @db.VarChar(255)
  finishReason       String?         @map("finish_reason") @db.VarChar(100)
  promptTokens       Int?            @map("prompt_tokens")
  completionTokens   Int?            @map("completion_tokens")
  totalTokens        Int?            @map("total_tokens")
  durationMs         Int?            @map("duration_ms")
  promptPreview      String?         @map("prompt_preview") @db.Text
  outputPreview      String?         @map("output_preview") @db.Text
  providerMetadata   Json?           @map("provider_metadata")
  toolCallsJson      Json?           @map("tool_calls_json")
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz

  telemetryRun       AiTelemetryRun  @relation(fields: [telemetryRunId], references: [id], onDelete: Cascade)

  @@unique([telemetryRunId, stepNumber])
  @@index([telemetryRunId])
  @@map("ai_telemetry_steps")
}

model AiTelemetryToolCall {
  id                 Int             @id @default(autoincrement())
  telemetryRunId     Int             @map("telemetry_run_id")
  toolCallId         String?         @map("tool_call_id") @db.VarChar(255)
  toolName           String          @map("tool_name") @db.VarChar(255)
  stepNumber         Int?            @map("step_number")
  success            Boolean         @default(true)
  durationMs         Int?            @map("duration_ms")
  argsJson           Json?           @map("args_json")
  resultJson         Json?           @map("result_json")
  error              String?         @db.Text
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz

  telemetryRun       AiTelemetryRun  @relation(fields: [telemetryRunId], references: [id], onDelete: Cascade)

  @@index([telemetryRunId, createdAt])
  @@index([toolName])
  @@map("ai_telemetry_tool_calls")
}

// App-level metadata (display names, AI suggestions, visibility)
model App {
  id                   Int      @id @default(autoincrement())
  appClass             String   @unique @map("app_class") @db.VarChar(255) // The WM_CLASS / window class from the activity tracker
  displayName          String?  @map("display_name") @db.VarChar(255) // User-set display name override
  hidden               Boolean  @default(false) // Hidden from timeline and analytics UI
  suggestedName        String?  @map("suggested_name") @db.VarChar(255) // AI-suggested display name
  suggestNameDismissed Boolean  @default(false) @map("suggest_name_dismissed") // User dismissed the AI suggestion
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([hidden])
  @@map("apps")
}

// Settings for storing user preferences and API keys
model Setting {
  id              Int         @id @default(autoincrement())
  key             String      @unique
  value           String      @db.Text
  appTitleRenames String[]    @default([]) @map("app_title_renames") // Cosmetic app-class => display-name overrides as `raw=pretty`
  hiddenAppClasses String[]   @default([]) @map("hidden_app_classes") // App classes hidden from timeline and analytics UI
  rescuetimeKey         String?     @map("rescuetime_key") @db.Text
  openaiKey       String?     @map("openai_key") @db.Text
  googleApiKey    String?     @map("google_api_key") @db.Text
  aiProvider      AiProvider? @default(openai) @map("ai_provider")
  jmapToken              String?  @map("jmap_token") @db.Text
  jmapUsername           String?  @map("jmap_username") @db.Text
  jmapHostname           String?  @map("jmap_hostname") @db.Text
  canReadMailbox         Boolean  @default(false) @map("can_read_mailbox") // Allow AI to read emails via JMAP
  jmapAllowedMailboxes   String[] @default([]) @map("jmap_allowed_mailboxes") // Mailbox IDs AI can search (empty = all mailboxes)
  webdavUrl              String?  @map("webdav_url") @db.Text // CalDAV server URL
  webdavUsername         String?  @map("webdav_username") @db.Text
  webdavPassword         String?  @map("webdav_password") @db.Text
  canReadCalendar        Boolean  @default(false) @map("can_read_calendar") // Allow AI to read calendar events via CalDAV
  webdavAllowedCalendars String[] @default([]) @map("webdav_allowed_calendars") // Calendar URLs AI can search (empty = all calendars)
  githubToken            String?  @map("github_token") @db.Text
  githubUsername         String?  @map("github_username") @db.Text
  gitlabToken            String?  @map("gitlab_token") @db.Text
  gitlabUsername         String?  @map("gitlab_username") @db.Text
  gitlabUrl              String?  @map("gitlab_url") @db.Text // Self-hosted GitLab URL (defaults to https://gitlab.com)
  codebergToken          String?  @map("codeberg_token") @db.Text
  codebergUsername       String?  @map("codeberg_username") @db.Text
  companyName            String?  @map("company_name") @db.Text
  freelancerName  String?     @map("freelancer_name") @db.Text
  freelancerEmail String?     @map("freelancer_email") @db.Text
  address         String?     @db.Text
  phone           String?     @db.Text
  website         String?     @db.Text
  mcpEnabled      Boolean     @default(true) @map("mcp_enabled")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

// RescueTime project metadata extracted from archive uploads
model RescueTimeProject {
  id           Int       @id @default(autoincrement())
  rtProjectId  Int       @unique @map("rt_project_id")
  name         String    @db.Text
  color        String?   @db.VarChar(20)
  notes        String[]  @default([]) // Matching keywords from RT project details
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz
  billable     Boolean?
  rate         Float?
  currency     String?   @db.VarChar(10)
  rtClientId   Int?      @map("rt_client_id")
  rtClientName String?   @map("rt_client_name") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  projectTimes RescueTimeProjectTime[]
  linkedProject Project?

  @@map("rescuetime_projects")
}

// Individual time blocks from RescueTime project history archive
model RescueTimeProjectTime {
  id              Int      @id @default(autoincrement())
  rtProjectId     Int      @map("rt_project_id")
  date            String   @db.VarChar(10) // YYYY-MM-DD for quick date lookups
  startTime       DateTime @map("start_time") @db.Timestamptz
  endTime         DateTime @map("end_time") @db.Timestamptz
  durationSeconds Int      @map("duration_seconds")
  draft           Boolean  @default(false)
  provenance      String?  @db.Text
  comment         String?  @db.Text
  importedAt      DateTime @default(now()) @map("imported_at") @db.Timestamptz

  project RescueTimeProject @relation(fields: [rtProjectId], references: [rtProjectId])

  @@unique([rtProjectId, startTime]) // Prevent duplicate entries on re-upload
  @@index([date])
  @@map("rescuetime_project_times")
}
